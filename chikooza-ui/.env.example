# Local API wiring for development.
# OLD: the project did not include an env template, so src/Constants.js could resolve API URLs as undefined.
# NEW: copy this file to .env and point the UI at your running Django API.
REACT_APP_API_BASE_URL=http://127.0.0.1:8002/
REACT_APP_TEMPLATE_BASE_URL=http://127.0.0.1:8002/
