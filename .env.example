# Local backend settings.
# U: OLD: chikooza/settings.py hardcoded SECRET_KEY, DEBUG=True, wildcard ALLOWED_HOSTS, and open CORS.
# U: NEW: configure those values through environment variables for safer local/deploy parity.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-dev-only-change-before-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.herokuapp.com
CHIKOOZA_CORS_ALLOW_ALL=True
# U: OLD: CHIKOOZA_CORS_ALLOWED_ORIGINS only listed the CRA port 3000.
# U: NEW: Vite defaults to 5173; keep 3000 temporarily for older local checkouts.
CHIKOOZA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CHIKOOZA_FIXED_OTP=123456

# Use PostgreSQL locally and in production for the same chatbot RAG behavior.
# Example local URL:
# DATABASE_URL=postgres://utkarsh@127.0.0.1:5432/chikooza_api

# OLD: chikooza/settings.py hardcoded HOSTNAME to http://127.0.0.1:8001/.
# NEW: CHIKOOZA_API_BASE_URL controls the OAuth/token callback base URL for local setup.
CHIKOOZA_API_BASE_URL=http://127.0.0.1:8002/

# Groq settings used by the database-backed public RAG chatbot and Farmer AI.
CHIKOOZA_PUBLIC_CHAT_TIMEOUT=20
GROQ_API_KEY=
# U: NEW: optional comma-separated Groq key pool. Keep real keys only in .env.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Database-backed chatbot RAG settings.
# Production should use DATABASE_URL pointed at PostgreSQL with the pgvector extension available.
# The migration creates `CREATE EXTENSION IF NOT EXISTS vector` and a vector(384) embedding column.
CHIKOOZA_RAG_VECTOR_DIMENSIONS=384
# SQLite local setup uses the Python retrieval fallback. Production sets this
# to True after provisioning PostgreSQL with pgvector.
CHIKOOZA_RAG_REQUIRE_PGVECTOR=False
CHIKOOZA_RAG_EMBEDDING_PROVIDER=hash
# For stronger production retrieval, set:
# CHIKOOZA_RAG_EMBEDDING_PROVIDER=sentence_transformers
CHIKOOZA_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHIKOOZA_RAG_CHUNK_SIZE=1200
CHIKOOZA_RAG_CHUNK_OVERLAP=180
CHIKOOZA_RAG_TOP_K=5
CHIKOOZA_RAG_MIN_SCORE=0.18
CHIKOOZA_RAG_LOCAL_SCAN_LIMIT=10000

# Farmer AI SQL agent settings.
# U: OLD: /ai/ used only the deterministic SQL mapper in aibot/modern_services.py.
# U: NEW: use Groq for Text-to-SQL when keys are configured. Keep the old
# U: deterministic mapper in code for reference/tests, but the live path uses
# U: the same 8B Groq model for SQL planning and answer formatting.
AIBOT_SQL_LLM_PROVIDER=groq
AIBOT_SQL_MODEL=llama-3.1-8b-instant
AIBOT_SQL_FALLBACK_MODEL=llama-3.1-8b-instant
AIBOT_SQL_ANSWER_MODEL=llama-3.1-8b-instant
AIBOT_SQL_TIMEOUT=30
