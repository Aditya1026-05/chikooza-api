# Local backend settings.
# U: OLD: chikooza/settings.py hardcoded SECRET_KEY, DEBUG=True, wildcard ALLOWED_HOSTS, and open CORS.
# U: NEW: configure those values through environment variables for safer local/deploy parity.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-dev-only-change-before-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.herokuapp.com
CHIKOOZA_CORS_ALLOW_ALL=True
# U: OLD: CHIKOOZA_CORS_ALLOWED_ORIGINS only listed the CRA port 3000.
# U: NEW: Vite defaults to 5173; keep 3000 temporarily for older local checkouts.
CHIKOOZA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CHIKOOZA_FIXED_OTP=123456

# OLD: chikooza/settings.py hardcoded HOSTNAME to http://127.0.0.1:8001/.
# NEW: CHIKOOZA_API_BASE_URL controls the OAuth/token callback base URL for local setup.
CHIKOOZA_API_BASE_URL=http://127.0.0.1:8002/

# Existing chatbot local LLM settings.
# OLD: chatbot/services.py hardcoded Ollama model llama3.2:3b with localhost defaults.
# NEW: keep them configurable; full chatbot answers require Ollama running and this model pulled locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Future Groq-backed chatbot/agent settings.
# U: OLD: the public Chikooza chatbot used the local RAG/Ollama path only.
# U: NEW: the public website assistant can use auto, groq, ollama, or fallback.
CHIKOOZA_PUBLIC_CHAT_PROVIDER=auto
CHIKOOZA_PUBLIC_CHAT_TIMEOUT=20
GROQ_API_KEY=
# U: NEW: optional comma-separated Groq key pool. Keep real keys only in .env.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Farmer AI SQL agent settings.
# U: OLD: /ai/ used only the deterministic SQL mapper in aibot/modern_services.py.
# U: NEW: use Groq for Text-to-SQL when keys are configured, with the old mapper
# U: kept as fallback if the LLM is unavailable or unsafe.
AIBOT_SQL_LLM_PROVIDER=groq
AIBOT_SQL_MODEL=llama-3.3-70b-versatile
AIBOT_SQL_FALLBACK_MODEL=llama-3.1-8b-instant
AIBOT_SQL_ANSWER_MODEL=llama-3.3-70b-versatile
AIBOT_SQL_TIMEOUT=30
