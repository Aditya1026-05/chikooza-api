# Chikooza Ubuntu 24.04 production configuration.
# Install as /etc/chikooza/server.env with mode 0600 and replace every
# "replace-..." value. Values are literal: do not use export or shell syntax.

# Required deployment source and public hostnames.
REPO_URL=https://github.com/RadianceVA/chikooza-api.git
REPO_BRANCH=correct-version
API_DOMAIN=api.chikooza.com
UI_DOMAIN=www.chikooza.com

# Required secrets. Generate a Django key with: openssl rand -hex 32
DB_PASSWORD=replace-with-a-long-random-database-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret

# Fixed application identity (do not change) and filesystem layout.
APP_NAME=chikooza
APP_USER=chikooza
APP_GROUP=chikooza
INSTALL_ROOT=/srv/chikooza
ROOT_DOMAIN=chikooza.com

# Managed PostgreSQL 16 with pgvector on this VPS.
MANAGE_DATABASE=true
PG_MAJOR=16
DB_NAME=chikooza
DB_USER=chikooza
DB_HOST=127.0.0.1
DB_PORT=5432

# Private repository access. Leave blank for a public HTTPS REPO_URL.
GIT_SSH_KEY=

# Runtime and release policy.
NODE_VERSION=22.23.1
GUNICORN_PORT=8001
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
RUN_INGEST=true
KEEP_RELEASES=5
KEEP_DB_BACKUPS=7
HEALTH_ATTEMPTS=30
HEALTH_DELAY=2
NGINX_UPLOAD_LIMIT=25m

# Enable only after API_DOMAIN, UI_DOMAIN, and ROOT_DOMAIN resolve to this VPS.
# First deploy with staging=true. After it succeeds, set staging=false and
# deploy again to obtain the production certificate through the webroot flow.
ENABLE_CERTBOT=true
CERTBOT_EMAIL=replace-with-your-email@example.com
CERTBOT_STAGING=true

# Optional AI configuration. Leave blank to use retrieval-only fallbacks.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=

# Additional non-reserved Django environment variables may use ENV__NAME=value.
