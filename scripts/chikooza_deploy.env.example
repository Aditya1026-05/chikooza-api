# Copy this file to scripts/chikooza_deploy.env on the Linux server.
# Fill real values there. Do not commit scripts/chikooza_deploy.env.

REPO_URL=https://github.com/your-org/chikooza-api.git
BRANCH=correct-version

PROJECT_DIR=/srv/chikooza
APP_DIR=/srv/chikooza/app
SERVICE_NAME=chikooza

API_DOMAIN=api.chikooza.com
UI_DOMAIN=www.chikooza.com
# Optional apex/root domain for frontend Nginx config.
ROOT_DOMAIN=chikooza.com

DB_NAME=chikooza_db
DB_USER=chikooza_user
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

DJANGO_SECRET_KEY=replace-with-long-random-django-secret
GROQ_API_KEY=replace-with-real-groq-key

# Set to true only if you want the script to install Node.js from NodeSource.
INSTALL_NODE=false

# Set to true only after DNS points API_DOMAIN/UI_DOMAIN to this server.
ENABLE_CERTBOT=false

# Usually true for first production deployment.
INSTALL_SYSTEM_PACKAGES=true
SETUP_DATABASE=true
RUN_INGEST=true
DEPLOY_FRONTEND=true

FRONTEND_WEB_ROOT=/var/www/chikooza-ui
GUNICORN_BIND=127.0.0.1:8001
GUNICORN_WORKERS=3
